    {
     "name": "attack",
     "raw": "GET /api/x HTTP/1.1\r\nHost: alpha.test\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\nGET /api/exec?cmd=id HTTP/1.1\r\nHost: alpha.test\r\nConnection: close\r\n\r\n"
